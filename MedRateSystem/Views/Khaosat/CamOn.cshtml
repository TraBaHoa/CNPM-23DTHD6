@{
    ViewData["Title"] = "Cảm Ơn Khách Hàng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">
            <div class="card shadow border-0 p-5 bg-white">
                <div class="mb-4">
                    <span style="font-size: 70px;">🎉</span>
                </div>
                <h2 class="text-success fw-bold mb-3">GỬI ĐÁNH GIÁ THÀNH CÔNG!</h2>
                <h4 class="text-dark mb-4">Hệ thống MedRateSystem xin chân thành cảm ơn Ông/Bà!</h4>
                
                <p class="text-muted fs-5 lh-base px-3">
                    Những ý kiến đóng góp quý báu của Ông/Bà về mức độ hài lòng và các phản ứng phụ khi sử dụng thuốc
                    sẽ là cơ sở dữ liệu quan trọng giúp đội ngũ Bác sĩ và Dược sĩ lâm sàng nâng cao chất lượng điều trị,
                    đảm bảo an toàn tối đa cho cộng đồng bệnh nhân.
                </p>

                <hr class="my-4" />

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Khaosat" asp-action="Login" class="btn btn-primary btn-lg px-4 gap-3 fw-bold">
                        ↩ Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
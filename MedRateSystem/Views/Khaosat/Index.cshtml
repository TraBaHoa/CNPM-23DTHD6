@model IEnumerable<MedRateSystem.Models.Thuoc>
@{
    var bn = ViewBag.BenhNhan as MedRateSystem.Models.BenhNhan;
    ViewData["Title"] = "Phiếu khảo sát thuốc";
}

<style>
    .rating { display: flex; flex-direction: row-reverse; justify-content: start; gap: 5px; }
    .rating input { display: none; }
    .rating label { font-size: 1.5rem; color: #ccc; cursor: pointer; transition: 0.2s; }
    .rating input:checked ~ label { color: #ffc107; }
    .rating label:hover, .rating label:hover ~ label { color: #ffdb70; }
    .btn-check:checked + .btn-outline-danger { background-color: #dc3545; color: white; }
</style>

<div class="container mt-4 mb-5" style="max-width: 850px;">
    <div class="card border-0 shadow-sm bg-dark text-white mb-4">
        <div class="card-body p-4 text-center">
            <h3 class="fw-bold">PHIẾU KHẢO SÁT AN TOÀN THUỐC</h3>
            <p class="mb-0 text-white-50">Bệnh nhân: <strong>@bn?.HoTen</strong> | Mã: <strong>@bn?.MaBenhNhan</strong></p>
            <div class="mt-3">
                <a asp-action="LichSu" asp-route-maBenhNhan="@bn?.MaBenhNhan" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi bi-clock-history"></i> Xem lịch sử đánh giá
                </a>
            </div>
        </div>
    </div>

    <form id="khaoSatForm" asp-action="GuiDanhGia" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="maBenhNhan" value="@bn?.MaBenhNhan" />

        @if (Model != null)
        {
            int index = 0;
            foreach (var thuoc in Model)
            {
                <div class="card mb-4 border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-bottom-0 pt-4">
                        <h5 class="fw-bold text-primary"><i class="bi bi-capsule"></i> Thuốc: @thuoc.TenThuoc</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <input type="hidden" name="DanhSachDanhGia[@index].MaThuoc" value="@thuoc.MaThuoc" />

                        @{
                            var tieuChis = new[] { 
                                ("DiemTongThe", "Tổng thể"), ("DiemHieuQua", "Hiệu quả"), 
                                ("DiemTacDungPhu", "Tác dụng phụ"), ("DiemTienLoi", "Tiện lợi") 
                            };
                        }

                        @foreach (var tc in tieuChis)
                        {
                            <div class="row mb-3 align-items-center">
                                <div class="col-4 fw-bold small text-muted text-uppercase">@tc.Item2</div>
                                <div class="col-8">
                                    <div class="rating">
                                        @for (int i = 5; i >= 1; i--)
                                        {
                                            <input type="radio" name="DanhSachDanhGia[@index].@tc.Item1" value="@i" id="@(tc.Item1 + index + i)" required />
                                            <label for="@(tc.Item1 + index + i)">★</label>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <hr />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase">Tác dụng phụ (Chọn nhiều):</label>
                            <div class="row g-2">
                                @foreach (var adr in new[] { "Chóng mặt", "Buồn nôn", "Dị ứng", "Buồn ngủ", "Khô miệng", "Khác" })
                                {
                                    <div class="col-6 col-md-4">
                                        <input type="checkbox" class="btn-check" value="@adr" id="adr_@index@adr" onchange="capNhatAdr(@index)">
                                        <label class="btn btn-outline-danger w-100 rounded-pill" for="adr_@index@adr">@adr</label>
                                    </div>
                                }
                            </div>
                            <input type="hidden" name="DanhSachDanhGia[@index].MoTaTrieuChung" id="moTa_@index" />
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold small text-uppercase">Nhận xét:</label>
                            <textarea name="DanhSachDanhGia[@index].NhanXet" class="form-control" rows="2" placeholder="Chia sẻ trải nghiệm..."></textarea>
                        </div>
                    </div>
                </div>
                index++;
            }
        }

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-success btn-lg shadow-sm rounded-pill py-3 fw-bold">
                🚀 GỬI BÁO CÁO ĐÁNH GIÁ
            </button>
        </div>
    </form>
</div>

<script>
    function capNhatAdr(index) {
        let checked = [];
        document.querySelectorAll(`input[id^="adr_${index}"]:checked`).forEach(el => checked.push(el.value));
        document.getElementById(`moTa_${index}`).value = checked.join(", ");
    }
</script>
@model IEnumerable<MedRateSystem.Models.Thuoc>
@{
    var bn = ViewBag.BenhNhan as MedRateSystem.Models.BenhNhan;
    ViewData["Title"] = "Thực hiện khảo sát";
}

<style>
    .rating-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.5rem;
    }
    
    .rating-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.8rem 0;
        border-bottom: 1px dashed #cbd5e1;
    }
    .rating-row:last-child { border-bottom: none; padding-bottom: 0; }
    
    .rating-stars {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
    }
    
    .rating-stars input { display: none; }
    
    .rating-stars label {
        font-size: 1.8rem;
        color: #e2e8f0;
        cursor: pointer;
        transition: 0.2s;
        margin-bottom: 0;
        line-height: 1;
    }
    
    .rating-stars label:hover,
    .rating-stars label:hover ~ label,
    .rating-stars input:checked ~ label {
        color: #f59e0b;
    }
    
    .label-required::after { content: " *"; color: #ef4444; }
    
    .form-control-custom {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
    }
    .form-control-custom:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        background-color: #ffffff;
    }
    
    .btn-submit-medical {
        background-color: #2563eb;
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.8rem;
        border-radius: 8px;
        transition: 0.2s;
    }
    .btn-submit-medical:hover {
        background-color: #1d4ed8;
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 900px;">
    
    <!-- HEADER VÀ TABS -->
    @await Html.PartialAsync("_KhaosatHeaderTabs")

    <!-- FORM ĐÁNH GIÁ -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4 p-md-5">
            <form asp-action="GuiDanhGia" method="post" id="surveyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DanhGia.MaBenhNhan" value="@bn?.MaBenhNhan" />

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="form-label label-required text-muted small fw-bold">Họ tên bệnh nhân</label>
                        <input type="text" class="form-control form-control-custom" value="@bn?.HoTen" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label label-required text-muted small fw-bold">Tình trạng bệnh</label>
                        <select class="form-select form-control-custom" name="DanhGia.TinhTrangBenh" required>
                            <option value="">-- Chọn --</option>
                            <option value="Tăng huyết áp">Tăng huyết áp (Amlodipine)</option>
                            <option value="Đái tháo đường">Đái tháo đường (Metformin)</option>
                            <option value="Rối loạn lipid máu">Rối loạn lipid máu (Atorvastatin)</option>
                            <option value="Đau dạ dày">Đau dạ dày (Omeprazole)</option>
                            <option value="Sốt, Đau nhức">Sốt, Đau nhức (Paracetamol)</option>
                            <option value="Nhiễm khuẩn">Nhiễm khuẩn (Amoxicillin)</option>
                            <option value="Dị ứng">Dị ứng (Loratadine)</option>
                            <option value="Tăng đề kháng">Tăng đề kháng (Vitamin C)</option>
                            <option value="Hen suyễn">Hen suyễn (Salbutamol)</option>
                            <option value="Viêm đau khớp">Viêm đau khớp (Ibuprofen)</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label label-required text-muted small fw-bold">Thuốc điều trị</label>
                    <select class="form-select form-control-custom fw-semibold" name="DanhGia.MaThuoc" style="color: #2563eb;" required>
                        <option value="">-- Chọn thuốc cần đánh giá --</option>
                        @if (Model != null)
                        {
                            foreach (var thuoc in Model)
                            {
                                <option value="@thuoc.MaThuoc">@thuoc.TenThuoc - @thuoc.NhaSanXuat</option>
                            }
                        }
                    </select>
                </div>

                <div class="rating-box mb-4">
                    <div class="rating-row">
                        <span class="fw-bold text-dark small label-required">Mức độ Hài lòng Tổng thể</span>
                        <div class="rating-stars">
                            <input type="radio" id="tt5" name="DanhGia.DiemTongThe" value="5" required /><label for="tt5">&#9733;</label>
                            <input type="radio" id="tt4" name="DanhGia.DiemTongThe" value="4" /><label for="tt4">&#9733;</label>
                            <input type="radio" id="tt3" name="DanhGia.DiemTongThe" value="3" /><label for="tt3">&#9733;</label>
                            <input type="radio" id="tt2" name="DanhGia.DiemTongThe" value="2" /><label for="tt2">&#9733;</label>
                            <input type="radio" id="tt1" name="DanhGia.DiemTongThe" value="1" /><label for="tt1">&#9733;</label>
                        </div>
                    </div>
                    <div class="rating-row">
                        <span class="fw-bold text-dark small label-required">Hiệu quả của thuốc</span>
                        <div class="rating-stars">
                            <input type="radio" id="hq5" name="DanhGia.DiemHieuQua" value="5" required /><label for="hq5">&#9733;</label>
                            <input type="radio" id="hq4" name="DanhGia.DiemHieuQua" value="4" /><label for="hq4">&#9733;</label>
                            <input type="radio" id="hq3" name="DanhGia.DiemHieuQua" value="3" /><label for="hq3">&#9733;</label>
                            <input type="radio" id="hq2" name="DanhGia.DiemHieuQua" value="2" /><label for="hq2">&#9733;</label>
                            <input type="radio" id="hq1" name="DanhGia.DiemHieuQua" value="1" /><label for="hq1">&#9733;</label>
                        </div>
                    </div>
                    <div class="rating-row">
                        <span class="fw-bold text-dark small label-required">Tác dụng phụ (5 = Tốt, ít tác dụng phụ)</span>
                        <div class="rating-stars">
                            <input type="radio" id="tdp5" name="DanhGia.DiemTacDungPhu" value="5" required /><label for="tdp5">&#9733;</label>
                            <input type="radio" id="tdp4" name="DanhGia.DiemTacDungPhu" value="4" /><label for="tdp4">&#9733;</label>
                            <input type="radio" id="tdp3" name="DanhGia.DiemTacDungPhu" value="3" /><label for="tdp3">&#9733;</label>
                            <input type="radio" id="tdp2" name="DanhGia.DiemTacDungPhu" value="2" /><label for="tdp2">&#9733;</label>
                            <input type="radio" id="tdp1" name="DanhGia.DiemTacDungPhu" value="1" /><label for="tdp1">&#9733;</label>
                        </div>
                    </div>
                    <div class="rating-row">
                        <span class="fw-bold text-dark small label-required">Sự tiện lợi khi dùng</span>
                        <div class="rating-stars">
                            <input type="radio" id="tl5" name="DanhGia.DiemTienLoi" value="5" required /><label for="tl5">&#9733;</label>
                            <input type="radio" id="tl4" name="DanhGia.DiemTienLoi" value="4" /><label for="tl4">&#9733;</label>
                            <input type="radio" id="tl3" name="DanhGia.DiemTienLoi" value="3" /><label for="tl3">&#9733;</label>
                            <input type="radio" id="tl2" name="DanhGia.DiemTienLoi" value="2" /><label for="tl2">&#9733;</label>
                            <input type="radio" id="tl1" name="DanhGia.DiemTienLoi" value="1" /><label for="tl1">&#9733;</label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Nhận xét thêm (Tuỳ chọn)</label>
                    <textarea class="form-control form-control-custom" name="DanhGia.NhanXet" rows="3" placeholder="Chia sẻ trải nghiệm của bạn về loại thuốc này..."></textarea>
                </div>

                <button type="submit" class="btn w-100 btn-submit-medical shadow-sm">
                    <i class="bi bi-send me-1"></i> Gửi phiếu đánh giá
                </button>
            </form>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}
<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-header bg-primary text-white text-center py-4">
            <h4 class="mb-0">HỆ THỐNG ĐÁNH GIÁ CHẤT LƯỢNG THUỐC</h4>
            <small>Dành cho bệnh nhân điều trị</small>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Error</div>
            }
            <form asp-action="Login" method="post">
                <div class="form-group mb-4">
                    <label class="font-weight-bold mb-2">Vui lòng nhập Mã Bệnh Nhân:</label>
                    <input type="text" name="maBenhNhan" class="form-control form-control-lg text-center" placeholder="Ví dụ: BN001" required />
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100 shadow">TIẾP TỤC ➔</button>
            </form>
        </div>
    </div>
</div>
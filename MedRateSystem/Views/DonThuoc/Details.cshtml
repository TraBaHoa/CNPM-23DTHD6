@model MedRateSystem.Models.DonThuoc

@{
    ViewData["Title"] = "Chi tiết đơn thuốc";
}

<div class="container mt-4" style="max-width: 900px;">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Quay lại danh sách đơn</a>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">📋 Chi tiết Đơn thuốc: @Model.MaDonThuoc</h4>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Mã bệnh nhân:</strong> @Model.MaBenhNhan</p>
                    <p><strong>Ngày kê đơn:</strong> @Model.NgayKeDon.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="badge bg-success">Đã hoàn thành</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Danh sách thuốc kê:</h5>
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên thuốc</th>
                        <th>Số lượng</th>
                        <th>Cách dùng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ChiTietDonThuocs != null && Model.ChiTietDonThuocs.Any())
                    {
                        @foreach (var item in Model.ChiTietDonThuocs)
                        {
                            <tr>
                                <td class="fw-bold">@item.Thuoc?.TenThuoc</td>
                                <td>@item.SoLuong</td>
                                <td><i class="text-muted">@item.CachDung</i></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Đơn thuốc không có chi tiết thuốc.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
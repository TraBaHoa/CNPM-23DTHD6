<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedRateSystem</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MedRateSystem.styles.css" asp-append-version="true" />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
            body { font-family: 'Inter', sans-serif; background-color: #f8f9fa; }
            .navbar-brand { font-weight: 700; letter-spacing: -0.5px; }
            .footer { font-size: 0.85rem; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container-fluid">
                <a class="navbar-brand text-primary" asp-controller="Khaosat" asp-action="Login">
                    🛡️ MedRateSystem
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Khaosat" asp-action="Login">
                                ➔ Khảo Sát Bệnh Nhân
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-danger" asp-controller="Admin" asp-action="Dashboard">
                                📊 Dashboard Bác Sĩ
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-4 bg-white">
        <div class="container">
            <p class="mb-1">&copy; 2026 - MedRateSystem | Hệ thống Giám sát & Đánh giá An toàn Thuốc</p>
            <small>Đồ án Phát triển Hệ thống Thông tin Y tế</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
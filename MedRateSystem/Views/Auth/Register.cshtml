@model MedRateSystem.Models.BenhNhan
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản Bệnh nhân";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedRateSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f4f8;
            background-image: radial-gradient(circle at 10% 20%, rgb(239, 246, 255) 0%, rgb(219, 234, 254) 90%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 2rem 0;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.05);
            padding: 2.5rem;
            width: 100%;
            max-width: 500px;
        }

        .brand-icon {
            width: 64px;
            height: 64px;
            background: #eff6ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: #2563eb;
            margin: 0 auto 1.5rem auto;
        }

        .form-control-custom {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            color: #334155;
            transition: all 0.2s;
        }

        .form-control-custom:focus {
            background: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
            outline: none;
        }

        .btn-custom {
            background-color: #2563eb;
            border: none;
            border-radius: 8px;
            padding: 0.8rem;
            font-weight: 600;
            color: white;
            transition: all 0.2s;
        }

        .btn-custom:hover {
            background-color: #1d4ed8;
            color: white;
        }
        
        .alert-custom {
            border-radius: 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #dc2626;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="auth-card">
            <div class="brand-icon">
                <i class="bi bi-person-vcard"></i>
            </div>
            <h4 class="text-center fw-bold mb-1" style="color: #0f172a;">Đăng Ký Tài Khoản</h4>
            <p class="text-center text-muted small mb-4">Điền thông tin để tham gia hệ thống</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-custom text-center p-2 mb-4">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.Error
                </div>
            }
            
            <form asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold text-muted small mb-1">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control form-control-custom w-100" placeholder="VD: Nguyễn Văn A" required autofocus autocomplete="off" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold text-muted small mb-1">Tài khoản <span class="text-danger">*</span></label>
                        <input asp-for="TaiKhoan" class="form-control form-control-custom w-100" placeholder="Tên đăng nhập" required autocomplete="off" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold text-muted small mb-1">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="form-control form-control-custom w-100" placeholder="0901234567" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-muted small mb-1">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control form-control-custom w-100" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-muted small mb-1">Giới tính</label>
                        <select asp-for="GioiTinh" class="form-select form-control-custom w-100" style="padding-top: 0.75rem; padding-bottom: 0.75rem;">
                            <option value="">-- Chọn --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="col-12 mb-4">
                        <label class="form-label fw-semibold text-muted small mb-1">Mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="MatKhau" type="password" class="form-control form-control-custom w-100" placeholder="••••••" required />
                    </div>
                </div>

                <button type="submit" id="btnSubmit" class="btn btn-custom w-100 mt-2 d-flex justify-content-center align-items-center">
                    <i class="bi bi-check-circle me-2"></i> <span>Đăng ký ngay</span>
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <a asp-controller="Auth" asp-action="Login" class="text-decoration-none fw-semibold" style="color: #2563eb;">
                    Đã có tài khoản? Đăng nhập ngay
                </a>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const btn = document.getElementById('btnSubmit');
            if (this.checkValidity()) {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';
                btn.classList.add('disabled');
            }
        });
    </script>
</body>
</html>
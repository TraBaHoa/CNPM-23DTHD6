@model IEnumerable<MedRateSystem.ViewModels.ThuocThongKeViewModel>
@{
    ViewData["Title"] = "Dashboard Quản Trị Bác Sĩ";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold mb-1">📊 BẢNG ĐIỀU KHIỂN Y TẾ</h2>
        <a asp-controller="Admin" asp-action="QuanLyBacSi" class="btn btn-outline-primary">Quản lý Bác sĩ</a>
    </div>
    
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card p-3 border-start border-primary border-4 shadow-sm">
                <div class="text-muted small text-uppercase fw-bold">Tổng số thuốc</div>
                <div class="fs-2 fw-bold text-primary">@Model.Count()</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card p-3 border-start border-success border-4 shadow-sm">
                <div class="text-muted small text-uppercase fw-bold">Tổng ca khảo sát</div>
                <div class="fs-2 fw-bold text-success">@Model.Sum(t => t.TongSoLuotDanhGia)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card p-3 border-start border-danger border-4 shadow-sm">
                <div class="text-muted small text-uppercase fw-bold">Cảnh báo ADR cao</div>
                <div class="fs-2 fw-bold text-danger">@Model.Count(t => t.TyLeADR > 5.0)</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card p-4 shadow-sm h-100">
                <h6 class="text-muted">Chỉ số Likert trung bình từng thuốc</h6>
                <canvas id="chartLikert" height="300"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-4 shadow-sm h-100">
                <h6 class="text-muted">Phân bổ tỷ lệ tác dụng phụ (ADR)</h6>
                <canvas id="chartADR" height="300"></canvas>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between">
            <span>📋 DANH SÁCH THUỐC & CHẤT LƯỢNG LÂM SÀNG</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-center">
                    <tr>
                        <th>Mã Thuốc</th>
                        <th class="text-start">Tên Thuốc</th>
                        <th>Lượt Khảo Sát</th>
                        <th>Tỷ Lệ ADR</th>
                        <th>Điểm Likert TB</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var thuoc in Model)
                    {
                        <tr>
                            <td><code>@thuoc.MaThuoc</code></td>
                            <td class="text-start fw-bold text-primary">@thuoc.TenThuoc</td>
                            <td>@thuoc.TongSoLuotDanhGia</td>
                            <td>
                                <span class="badge @(thuoc.TyLeADR > 5 ? "bg-danger" : "bg-success")">
                                    @thuoc.TyLeADR%
                                </span>
                            </td>
                            <td><span class="fw-bold">@thuoc.DiemLikertTB</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // SỬA LỖI TẠI ĐÂY: Dùng ngoặc đơn bao quanh Html.Raw
        rawData = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))'.replace(/&quot;/g, '"'));

        if (rawData && rawData.length > 0) {
        const labels = rawData.map(i => i.TenThuoc);
        const dataLikert = rawData.map(i => i.DiemLikertTB);
        const dataADR = rawData.map(i => i.TyLeADR);

        new Chart(document.getElementById('chartLikert'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ label: 'Điểm Likert TB', data: dataLikert, backgroundColor: '#ffc107' }] },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('chartADR'), {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: dataADR, backgroundColor: ['#dc3545', '#fd7e14', '#0d6efd', '#20c997'] }] },
        options: { responsive: true, maintainAspectRatio: false }
        });
        }
    </script>
}
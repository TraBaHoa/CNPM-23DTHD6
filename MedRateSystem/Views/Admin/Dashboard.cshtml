@model IEnumerable<MedRateSystem.Controllers.ThuocThongKeViewModel>
@{
    ViewData["Title"] = "Dashboard Quản Trị Bác Sĩ";
    // Tối ưu hóa việc truyền dữ liệu
    var jsonModelData = System.Text.Json.JsonSerializer.Serialize(Model);
}

<div class="container-fluid mt-4 px-4">
    <div class="row align-items-center mb-4">
        <div class="col-md-9">
            <h2 class="text-dark fw-bold mb-1">📊 HỆ THỐNG GIÁM SÁT AN TOÀN THUỐC</h2>
        </div>
    </div>
    
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card p-3 border-start border-primary border-4 shadow-sm"><div class="text-muted small fw-bold">THUỐC THEO DÕI</div><div class="fs-2 fw-bold text-primary">@Model.Count()</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3 border-start border-success border-4 shadow-sm"><div class="text-muted small fw-bold">TỔNG CA KHẢO SÁT</div><div class="fs-2 fw-bold text-success">@Model.Sum(t => t.TongSoLuotDanhGia)</div></div></div>
        <div class="col-6 col-lg-3"><div class="card p-3 border-start border-danger border-4 shadow-sm"><div class="text-muted small fw-bold">VI PHẠM NGƯỠNG</div><div class="fs-2 fw-bold text-danger">@Model.Count(t => t.TyLeADR > 5.0)</div></div></div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-8"><div class="card p-4 shadow-sm"><canvas id="chartLikert" height="300"></canvas></div></div>
        <div class="col-lg-4"><div class="card p-4 shadow-sm"><canvas id="chartADR" height="300"></canvas></div></div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white fw-bold">📋 DANH SÁCH CHẤT LƯỢNG LÂM SÀNG</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center">
                <thead><tr><th>Mã Thuốc</th><th>Tên Thuốc</th><th>Lượt Khảo Sát</th><th>Tỷ Lệ ADR</th></tr></thead>
                <tbody>
                    @foreach (var thuoc in Model)
                    {
                        <tr>
                            <td>@thuoc.MaThuoc</td>
                            <td class="fw-bold text-primary">@thuoc.TenThuoc</td>
                            <td>@thuoc.TongSoLuotDanhGia</td>
                            <td><span class="badge @(thuoc.TyLeADR > 5 ? "bg-danger" : "bg-info")">@thuoc.TyLeADR%</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // SỬA LỖI TẠI ĐÂY: Dùng ngoặc đơn bao quanh Html.Raw
        rawData = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))'.replace(/&quot;/g, '"'));

        if (rawData && rawData.length > 0) {
        const labels = rawData.map(i => i.TenThuoc);
        const dataLikert = rawData.map(i => i.DiemLikertTB);
        const dataADR = rawData.map(i => i.TyLeADR);

        new Chart(document.getElementById('chartLikert'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ label: 'Điểm Likert TB', data: dataLikert, backgroundColor: '#ffc107' }] },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('chartADR'), {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: dataADR, backgroundColor: ['#dc3545', '#fd7e14', '#0d6efd', '#20c997'] }] },
        options: { responsive: true, maintainAspectRatio: false }
        });
        }
    </script>
}
@model IEnumerable<MedRateSystem.Models.BacSi>
@{
    ViewData["Title"] = "Quản lý Bác sĩ";
}

<style>
    body { background-color: #f0fdfa; font-family: 'Inter', sans-serif; }
    .admin-card {
        background: #fff; border-radius: 12px; box-shadow: 0 4px 15px rgba(13, 148, 136, 0.05); border: 1px solid #ccfbf1;
    }
    .bg-teal { background-color: #0d9488 !important; color: white !important; }
    .text-teal { color: #0d9488 !important; }
    .table-admin th { background-color: #0f766e !important; color: white; font-weight: 600; }
    .table-admin tbody tr:hover { background-color: #f0fdfa; }
</style>

<div class="container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-teal fw-bold mb-0"><i class="bi bi-person-badge me-2"></i>Danh sách Bác sĩ / Quản trị viên</h3>
        <a asp-action="Dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại Dashboard</a>
    </div>

    <div class="admin-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-admin align-middle mb-0">
                <thead class="text-center">
                    <tr>
                        <th>Mã Bác Sĩ</th>
                        <th class="text-start">Họ Tên</th>
                        <th>Tài Khoản</th>
                        <th>Chức Năng</th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @if(!Model.Any()) {
                        <tr><td colspan="4" class="text-muted p-4">Không có dữ liệu bác sĩ.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.MaBacSi</span></td>
                            <td class="text-start fw-bold">@item.HoTen</td>
                            <td><span class="text-primary fw-semibold">@item.TaiKhoan</span></td>
                            <td>
                                @if(item.TaiKhoan == "admin") {
                                    <span class="badge bg-success">Tài khoản gốc</span>
                                } else {
                                    <form asp-action="XoaBacSi" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa bác sĩ này?');">
                                        <input type="hidden" name="id" value="@item.MaBacSi" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Xóa</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
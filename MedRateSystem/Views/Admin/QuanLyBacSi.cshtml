@model IEnumerable<MedRateSystem.Models.BacSi>
@{
    ViewData["Title"] = "Quản lý Bác sĩ";
}

<div class="container mt-4">
    <h2>Danh sách Bác sĩ</h2>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã Bác sĩ</th>
                <th>Họ tên</th>
                <th>Tài khoản</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaBacSi</td>
                    <td>@item.HoTen</td>
                    <td>@item.TaiKhoan</td>
                    <td>
                        <form asp-action="XoaBacSi" method="post">
                            <input type="hidden" name="id" value="@item.MaBacSi" />
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>